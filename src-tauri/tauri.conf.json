{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sgltoolkt",
  "version": "2.0.2-beta.1",
  "identifier": "com.lsw.sgltoolkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SGLToolKit V2.0.3",
        "width": 1240,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": false,
    "targets": [],
    "resources": [
      "binaries/FontAwesome.otf",
      "binaries/Blockheads United.ttf",
      "binaries/CatgirlSystemFont-Regular.otf",
      "binaries/Floralia Dingbat.ttf",
      "binaries/HazardSigns.ttf",
      "binaries/Herlora Floral Dingbat.ttf",
      "binaries/MaterialIcons-Regular.ttf",
      "binaries/MaterialIconsOutlined-Regular.otf",
      "binaries/MaterialIconsRound-Regular.otf",
      "binaries/MaterialIconsSharp-Regular.otf",
      "binaries/MaterialIconsTwoTone-Regular.otf",
      "binaries/Numberpile.otf",
      "binaries/Oil Crisis A.otf",
      "binaries/Oil Crisis B.otf",
      "binaries/Type Icons.ttf",
      "binaries/icon-works-webfont.ttf"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/32x32.ico"
    ]
  }
}
